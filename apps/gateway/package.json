{
  "name": "@chatgpt-code-mcp/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute chatgpt-code-mcp --local --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute chatgpt-code-mcp --remote --file=src/db/schema.sql"
  },
  "dependencies": {
    "@chatgpt-code-mcp/protocol": "workspace:*",
    "hono": "^4.6.9",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
